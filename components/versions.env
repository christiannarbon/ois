# components/versions.env
# Single source of pinned versions for every chart, image and jar in the stack.
# Format: KEY="value" per line. No export, no expansion. Never "latest", never ranges.
# An empty value means "not pinned yet": it is pinned when that component is added.

# Storage — RustFS
RUSTFS_CHART_REPO="https://charts.rustfs.com"
RUSTFS_CHART_VERSION=""
RUSTFS_APP_VERSION=""
AWSCLI_IMAGE=""

# Ingestion — Strimzi operator + Kafka
STRIMZI_CHART_VERSION=""
KAFKA_VERSION=""

# Catalog — Apache Polaris + PostgreSQL
POLARIS_CHART_VERSION=""
POLARIS_APP_VERSION=""
POSTGRES_IMAGE=""

# Processing — Flink Kubernetes Operator (webhook off, so no cert-manager) + Flink/Iceberg
FLINK_OPERATOR_CHART_VERSION=""
FLINK_VERSION=""
ICEBERG_VERSION=""

# Query — Trino
TRINO_CHART_VERSION=""
TRINO_APP_VERSION=""

# Orchestration — Dagster + dbt-trino
DAGSTER_CHART_VERSION=""
DAGSTER_VERSION=""
DBT_TRINO_VERSION=""

# BI — Superset
SUPERSET_CHART_VERSION=""
SUPERSET_APP_VERSION=""
