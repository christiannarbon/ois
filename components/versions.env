# components/versions.env
# Authoritative Helm chart versions and app (container) versions for open-iceberg-stack.
# Source this file or evaluate its variables during chart installations.
# NEVER use 'latest' or unpinned floating chart versions.

# Storage Substrate (RustFS)
RUSTFS_CHART_VERSION="0.1.0"
RUSTFS_APP_VERSION="1.0.0"

# Iceberg REST Catalog
CATALOG_CHART_VERSION="0.1.0"
CATALOG_APP_VERSION="0.7.1"

# Ingestion Substrate (Kafka / Strimzi)
KAFKA_CHART_VERSION="0.41.0"
KAFKA_APP_VERSION="3.7.0"

# Processing Engine (Flink / Spark)
FLINK_CHART_VERSION="1.19.0"
FLINK_APP_VERSION="1.19.0"

# Query Engine (Trino)
TRINO_CHART_VERSION="0.28.0"
TRINO_APP_VERSION="442"

# Business Intelligence (Superset)
SUPERSET_CHART_VERSION="0.12.8"
SUPERSET_APP_VERSION="4.0.1"

# Pipeline Orchestration (Airflow)
AIRFLOW_CHART_VERSION="1.13.0"
AIRFLOW_APP_VERSION="2.9.1"
