# components/cluster/cluster.env
# Declarative Minikube cluster configuration for open-iceberg-stack.
# Source this file or evaluate its environment variables when starting Minikube.

# Profile & Driver (overridable by environment)
PROFILE="${PROFILE:-open-iceberg}"
DRIVER="${DRIVER:-docker}"
KUBERNETES_VERSION="${KUBERNETES_VERSION:-v1.30.0}"

# StorageClass Addons (Required for dynamic PV provisioning)
ADDONS="${ADDONS:-default-storageclass storage-provisioner}"

# Sizing Profiles:
# 1. Foundation Default: 2 vCPU / 4096 MiB RAM / 20 GiB disk
# 2. Lean Full-Stack (opt-in via FULL_STACK=1): 4 vCPU / 7168 MiB RAM / 30 GiB disk
FULL_STACK="${FULL_STACK:-0}"

if [ "${FULL_STACK}" = "1" ] || [ "${FULL_STACK}" = "true" ]; then
  CPUS="${CPUS:-4}"
  MEMORY="${MEMORY:-7168}"
  DISK_SIZE="${DISK_SIZE:-30g}"
else
  CPUS="${CPUS:-2}"
  MEMORY="${MEMORY:-4096}"
  DISK_SIZE="${DISK_SIZE:-20g}"
fi

# Formatted minikube start flag string (includes --interactive=false for non-interactive automation)
MINIKUBE_START_ARGS="-p ${PROFILE} --driver=${DRIVER} --kubernetes-version=${KUBERNETES_VERSION} --cpus=${CPUS} --memory=${MEMORY} --disk-size=${DISK_SIZE} --interactive=false"
