# .env.example
# Copy to '.env' (gitignored) and set real values. Never commit real credentials.
# Format: KEY=value, or KEY="value" when it has spaces or '#'. No 'export', no inline comments.

# RustFS S3 access key (>= 3 chars)
RUSTFS_ROOT_USER=admin
# RustFS S3 secret key (>= 8 chars, not rustfsadmin)
RUSTFS_ROOT_PASSWORD=change-me-local-password
