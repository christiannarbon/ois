# .env.example
# Template for local development environment secrets and credentials.
# Copy this file to '.env' (gitignored) and populate with your local dev credentials.
# NEVER commit real credentials to version control.

# Storage Substrate (RustFS / S3 Credentials)
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=change-me-local-password

# Catalog Credentials
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me-catalog-password

# Query Engine Credentials
TRINO_SHARED_SECRET=change-me-trino-secret
